# Port the Jev-like API listens on
PORT=8090

# Upstream OpenAI-compatible gateway ("the Alex Gateway")
UPSTREAM_BASE_URL=https://inference.alexandra.dk/v1
UPSTREAM_API_KEY=sk_live_...
UPSTREAM_MODEL=qwen3.8-flash-next

# Jev emulation knobs
# Public model id returned in responses (the versioned model behind the aliases)
MODEL_VERSION=jev-1.13.0
# Monte-Carlo samples per question (higher = smoother probabilities, more upstream calls)
SAMPLES=16
# Sampling temperature for the snap-decision distribution
TEMPERATURE=1.0
# Max concurrent upstream calls per server process (gateway allows 50)
CONCURRENCY=24
# Upstream call timeout in ms
UPSTREAM_TIMEOUT=30000
